# LuK Stabsansicht - Umgebungsvariablen
# Kopieren nach config/.env und anpassen. Alle Werte koennen auch als echte
# Umgebungsvariablen gesetzt werden (Docker); die gewinnen vor dieser Datei.
# Ohne jede Konfiguration laeuft das Programm mit Standardwerten auf
# 127.0.0.1:8080 und legt data/ (Datenbank, Sitzungen, Secret) neben config/ an.

# Geheime Zeichenkette (Token-Hashing, IP-Pseudonymisierung). Leer = wird beim
# ersten Start erzeugt und in data/.app_secret abgelegt.
APP_SECRET=

# Oeffentliche Basis-URL (Passwort-Reset-Mails, Freigabelinks)
APP_BASE_URL=https://luk.example.org
APP_NAME=THW LuK

# Adresse, auf der der Webserver lauscht. Davor gehoert ein Reverse-Proxy mit
# TLS (nginx, Caddy, Cloudflare-Tunnel). Fuer den lokalen PC reicht der Standard.
LISTEN_ADDR=127.0.0.1:8080

# Datenverzeichnis (SQLite, Sitzungen, STEIN-Cache, Secret). Standard: data/
#DATA_DIR=/var/lib/luk
# Pfad zur SQLite-Datei (Standard: <DATA_DIR>/auth.sqlite)
#DB_PATH=/var/lib/luk/auth.sqlite

# Absender fuer Systemmails (Passwort-Reset). Absender und SMTP lassen sich auch
# in der Oberflaeche setzen (Serververwaltung > Server); diese Werte gehen vor.
MAIL_FROM=no-reply@luk.example.org
MAIL_FROM_NAME=THW LuK Stabsansicht

# SMTP-Versand ueber den Mailanbieter (empfohlen). Ohne SMTP_HOST versucht das
# Programm /usr/sbin/sendmail (lokaler MTA).
# Test: luk mail-test empfaenger@example.org
#SMTP_HOST=smtp.example.org
#SMTP_PORT=587
# ssl (meist Port 465) | tls = STARTTLS (meist Port 587) | none
#SMTP_SECURITY=tls
#SMTP_USER=no-reply@luk.example.org
#SMTP_PASS=geheim

# Versionsnummer (wird beim Bauen in das Binary geschrieben; hier nur fuer
# scripts/build.sh, docker/make-archive.sh und als Fallback) und Copyright-Jahr
APP_VERSION=3.2.7
APP_COPYRIGHT_YEAR=2026

# Stammdaten (Landesverband, Regionalstellen, Ortsverbaende mit Einheiten,
# Kartenmittelpunkt, regionale Nachrichten-Feeds, Bezirksebene): beim Bauen
# wird public/daten/stammdaten.json eingebettet, wenn sie vorliegt (nicht im
# Repository; Aufbau siehe public/daten/stammdaten.example.json), sonst die
# Beispieldatei. Alternativ eine Datei auf dem Rechner angeben, die beim Start
# gelesen wird (gewinnt vor der eingebetteten).
#STAMM_FILE=/etc/luk/stammdaten.json

# Kartenzentrum fuer Dashboard-Karten und neue Lagekarten. Leer = Abschnitt
# "karte" der Stammdaten, sonst Mitte Deutschlands. Eine Organisation nutzt
# ihren Stammdaten-Standort oder einen eigenen Mittelpunkt aus
# "Organisation verwalten > Einstellungen".
#MAP_CENTER_LAT=52.52
#MAP_CENTER_LNG=13.405
#MAP_CENTER_NAME=THW LV Musterland

# Live-Sync: Polling-Intervall der Clients in ms
SYNC_INTERVAL_MS=7000

# Sitzungen: Leerlauf in Minuten, nach dem eine Anmeldung verfaellt
SESSION_IDLE_MIN=720

# Reverse-Proxy-IPs/-Netze, deren X-Forwarded-For und X-Forwarded-Proto
# vertraut wird (Komma-getrennt). Im Docker-Image vorbelegt mit privaten Netzen.
#TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8

# Externe Dienste werden direkt vom Programm abgerufen (ausgehendes HTTPS
# noetig), kurz gecacht und nur an angemeldete Nutzer ausgeliefert.
#
# Zugaenge zu STEIN und Divera gehoeren der Organisation (OV/RSt/LV), nicht
# dem Server: Org-Admins hinterlegen sie unter "Organisation verwalten".
# Die Basis-URLs sind nur fuer Tests und Sonderfaelle gedacht.
#STEIN_BASE_URL=https://stein.app/api/api/ext
#DIVERA_BASE_URL=https://app.divera247.com/api/v2
#NINA_BASE_URL=https://warnung.bund.de/api31
#LHP_BASE_URL=https://api.hochwasserzentralen.de
# Adresssuche (Nominatim) und Routing (OSRM) fuer STEINmap und die Ortswahl der
# Organisation; der Server fragt hoechstens einmal je Sekunde an und cacht.
#NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
#OSRM_BASE_URL=https://router.project-osrm.org
# Zusaetzliche Hosts, deren RSS-Feeds das Dashboard laden darf (Komma-getrennt;
# Hosts eigener Feeds einer Organisation sind automatisch erlaubt;
# tagesschau.de und gdacs.org sowie die Hosts der Standard-Feeds aus den
# Stammdaten sind immer erlaubt)
#RSS_ALLOWED_HOSTS=
# Eigene Feeds einer Organisation duerfen nicht auf localhost oder private
# Netze zeigen (Schutz vor Server-Side Request Forgery). 1 = doch erlauben,
# z.B. fuer einen Feed-Server im eigenen Netz. Hosts aus RSS_ALLOWED_HOSTS
# duerfen immer intern liegen.
#RSS_ALLOW_PRIVATE=0
# Kacheln (OpenStreetMap). Quelle, Freigabe und Token lassen sich auch in der
# Oberflaeche setzen (Admin > Server); diese Werte gehen den folgenden vor.
# Jede Installation hat einen eingebauten Kachel-Cache
# unter /tiles/... (Platte: <DATA_DIR>/tiles, 30 Tage frisch), damit an einem
# Standort mit mehreren Installationen nicht jede einzeln bei OSM anfragt.
# TILE_URL: Kachel-URL fuer den Browser. Standard = eingebauter Cache. Alternativ
# eine externe Quelle (Node-Skript oder anderer LuK-Server); der eingebaute
# Cache bleibt dann ungenutzt.
#TILE_URL=/tiles/{z}/{x}/{y}.png
# TILE_SOURCE: woher der eingebaute Cache fehlende Kacheln holt. Standard OSM;
# am Standort auf einen zentralen Kachel-Dienst oder den zentralen LuK stellen,
# damit der Standort nach aussen nur mit EINER Quelle auftritt, z.B.
#   https://luk-lv.example/tiles/{z}/{x}/{y}.png?key=TOKEN
#TILE_SOURCE=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# TILE_PUBLIC=1: Kachel-Endpunkt auch ohne Sitzung erreichbar (CORS *), damit
# andere Installationen ihn als TILE_SOURCE nutzen koennen. Standard 0 = nur
# fuer angemeldete Nutzer dieser Installation (kein offener Proxy).
#TILE_PUBLIC=0
# TILE_TOKEN: mit TILE_PUBLIC=1 brauchen Zugriffe ohne Sitzung ?key=TOKEN
# (oder Header X-Tile-Key). Angemeldete Nutzer brauchen nie einen Token.
#TILE_TOKEN=
# Obergrenze des Platten-Caches in MB (aelteste Kacheln werden geloescht; 0 = unbegrenzt)
#TILE_CACHE_MAX_MB=2000


# Update-Kanal (Admin > System-Update):
#   docker  Archive/Trigger werden in UPDATE_DIR abgelegt, der Host-Dienst
#           luk-updater spielt sie ein (siehe docker/).
#   binary  Das Programm aktualisiert sich selbst: ein neues Binary wird im
#           Browser hochgeladen, Pruefsumme und (mit UPDATE_PUBKEY) Signatur
#           geprueft, Datei getauscht, Neustart.
#   leer    keine Update-Seite
#UPDATE_MODE=binary
#UPDATE_DIR=/app/updates
# minisign-Public-Key (zweite Zeile der .pub-Datei): gesetzt = nur signierte Updates
#UPDATE_PUBKEY=
# Maximale Groesse eines Uploads in MB
UPDATE_MAX_MB=500
