# THW LuK Stabsansicht - nginx als Reverse-Proxy vor dem Binary (ohne Docker).
#
# Ziel: /etc/nginx/sites-available/luk.example.org (+ Symlink in sites-enabled),
# Zertifikat z.B. per certbot --nginx. Das Programm lauscht auf LISTEN_ADDR
# (Standard 127.0.0.1:8080), liefert statische Dateien selbst aus und setzt
# die Sicherheits-Header; nginx macht nur TLS und reicht die Client-IP durch
# (TRUSTED_PROXIES=127.0.0.1 in config/.env setzen).

server {
    listen 80;
    listen [::]:80;
    server_name luk.example.org;
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name luk.example.org;

    ssl_certificate     /etc/letsencrypt/live/luk.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/luk.example.org/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;

    # Gesamtexport-Import bis 50 MB; Update-Upload kommt in 8-MB-Teilen.
    client_max_body_size 52m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 180s;
    }
}
